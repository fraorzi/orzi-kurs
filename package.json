{
  "name": "orzi-kurs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ignore-pattern tracks",
    "test:harness": "vitest run harness",
    "submit": "tsx harness/cli.ts submit",
    "commit:task": "tsx harness/cli.ts commit",
    "verify:solutions": "tsx harness/cli.ts verify",
    "verify:starters": "tsx harness/cli.ts verify-starters",
    "verify:solutions:ts7": "ORZI_TSC_PACKAGE=typescript7 tsx harness/cli.ts verify ts",
    "verify:starters:ts7": "ORZI_TSC_PACKAGE=typescript7 tsx harness/cli.ts verify-starters ts"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-sonarjs": "^4.1.0",
    "jsdom": "29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^4.1.10"
  }
}
