{
  "name": "orzi-kurs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ignore-pattern tracks",
    "test:harness": "vitest run harness",
    "submit": "node --import tsx harness/cli.ts submit",
    "commit:task": "node --import tsx harness/cli.ts commit",
    "verify:solutions": "node --import tsx harness/cli.ts verify",
    "verify:starters": "node --import tsx harness/cli.ts verify-starters",
    "verify:solutions:ts7": "ORZI_TSC_PACKAGE=typescript7 node --import tsx harness/cli.ts verify ts",
    "verify:starters:ts7": "ORZI_TSC_PACKAGE=typescript7 node --import tsx harness/cli.ts verify-starters ts",
    "audit:curriculum": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types harness/curriculum-audit.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-window": "2.2.7",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "jsdom": "29.1.1",
    "mysql2": "3.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^4.1.10"
  }
}
